{
  "name": "wavezync-nest-starter",
  "version": "3.0.0",
  "description": "WaveZync Nest Starter",
  "author": "Kasun Vithanage <kasun@wavezync.com> (https://kasvith.me)",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/wavezync/nestjs-starter.git"
  },
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 0.0.0.0:9229 --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "kysely": "kysely",
    "kysely:migrate:latest": "kysely migrate:latest",
    "kysely:migrate:up": "kysely migrate:up",
    "kysely:migrate:down": "kysely migrate:down",
    "kysely:migrate:rollback:all": "kysely migrate:rollback --all",
    "kysely:prod": "kysely --config dist/kysely.config.js",
    "kysely:prod:migrate:latest": "pnpm run kysely:prod migrate:latest",
    "kysely:prod:migrate:up": "pnpm run kysely:prod migrate:up",
    "kysely:prod:migrate:down": "pnpm run kysely:prod migrate:down",
    "kysely:prod:migrate:rollback:all": "pnpm run kysely:prod migrate:rollback --all",
    "doc:generate": "npx compodoc -p tsconfig.json -n \"Documentation\"",
    "doc:serve": "npx compodoc -p tsconfig.json -n \"Documentation\" -s"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nanogiants/nestjs-swagger-api-exception-decorator": "^1.7.4",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/devtools-integration": "^12.0.0",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@scalar/nestjs-api-reference": "^1.2.17",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.3.0",
    "dataloader": "^2.2.3",
    "find-config": "^1.0.0",
    "graphql": "^17.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.5",
    "nestjs-pino": "^5.1.0",
    "pg": "^8.23.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@compodoc/compodoc": "^2.0.0",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "kysely-ctl": "^0.21.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.1.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@12.3.4"
}
